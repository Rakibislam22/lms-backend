{
    "kind": "collectionType",
    "collectionName": "lesson_progresses",
    "info": {
        "singularName": "lesson-progress",
        "pluralName": "lesson-progresses",
        "displayName": "LessonProgress"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "student": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "plugin::users-permissions.user"
        },
        "lesson": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::lesson.lesson"
        },
        "completed": {
            "type": "boolean",
            "default": false
        }
    }
}
