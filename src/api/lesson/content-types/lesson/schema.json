{
    "kind": "collectionType",
    "collectionName": "lessons",
    "info": {
        "singularName": "lesson",
        "pluralName": "lessons",
        "displayName": "Lesson"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "content": {
            "type": "richtext"
        },
        "videoUrl": {
            "type": "string"
        },
        "order": {
            "type": "integer",
            "default": 1
        },
        "course": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::course.course",
            "inversedBy": "lessons"
        }
    }
}
